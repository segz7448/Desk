# Copy to .env, edit, and chmod 600. Do not commit .env.
DESK_HOSTNAMES=desk.example.com
DESK_LOGIN=desk
DESK_DB_PATH=state/auth.sqlite
DESK_FEED_INPUT=app/app/status.json
# Create a Cloudflare Tunnel published application hostname to http://127.0.0.1:6081.
# Paste its token locally here or leave blank to run only on localhost.
CLOUDFLARE_TUNNEL_TOKEN=
